{
  "name": "agent-wiki",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "prettier --check . && npm run typecheck",
    "format": "prettier --write .",
    "typecheck": "tsc --project tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "prepare": "npm run build:ui",
    "wiki": "node bin/wiki.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "gray-matter": "4.0.3",
    "jose": "6.2.8",
    "lowlight": "3.3.0",
    "mermaid": "11.16.1",
    "openid-client": "6.8.5",
    "otpauth": "9.5.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "description": "A small Git-backed Markdown wiki with native WebMCP and on-demand agent traces.",
  "license": "MIT",
  "author": "Chris Reynolds",
  "overrides": {
    "oauth4webapi": "3.8.7",
    "jose": "6.2.8",
    "dompurify": "3.4.17",
    "katex": "0.18.2"
  }
}
